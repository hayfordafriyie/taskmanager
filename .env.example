POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskmanager
REDIS_PASSWORD=change-me

# Redis cache. Inside docker-compose the host is "redis"; for local runs use
# 127.0.0.1. If Redis is unreachable the backend disables caching and keeps
# serving requests (reads go straight to Postgres).
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

SMS_KEY=change-me
SMS_API_KEY=change-me
SENDER_ID=change-me
DEFAULT_SMS_SENDER_ID=change-me
SMS_BASE_URL=https://api.mnotify.com/api/sms/quick

TLS_CERT=/certs/server.crt
TLS_KEY=/certs/server.key

VITE_API_URL=https://localhost:8080
VITE_API_VERSION=v1
VITE_ENCRYPTED_MARKER=1

SERVER_PORT=8080