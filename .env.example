POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskmanager
REDIS_PASSWORD=change-me

# Redis cache. Inside docker-compose the host is "redis"; for local runs use
# 127.0.0.1. If Redis is unreachable the backend disables caching and keeps
# serving requests (reads go straight to Postgres).
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Public URL of the app, used in SMS links (invites, password resets).
APP_URL=https://localhost:5173

# Browser origins allowed to call the API (comma-separated, exact match).
# REQUIRED in production, e.g. https://app.example.com — when this is empty the
# backend only accepts loopback origins (localhost / 127.0.0.1) for local dev.
CORS_ORIGINS=

SMS_KEY=change-me
SMS_API_KEY=change-me
SENDER_ID=change-me
DEFAULT_SMS_SENDER_ID=change-me
SMS_BASE_URL=https://api.mnotify.com/api/sms/quick

# Optional: only set these when the API itself terminates TLS. The default
# deployment terminates TLS in the reverse proxy (Caddy), so leave them empty.
TLS_CERT=
TLS_KEY=

VITE_API_URL=https://localhost:8080
VITE_API_VERSION=v1
VITE_ENCRYPTED_MARKER=1

SERVER_PORT=8080