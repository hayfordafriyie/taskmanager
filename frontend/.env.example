# Frontend runtime config. VITE_ prefixed variables are inlined into the bundle
# at build time by Vite.
#
# Base URL of the Go backend. Leave empty to serve through the same origin
# (Vite dev proxy /api -> http://localhost:8080).
VITE_API_URL=http://localhost:8080
# API version segment of the encrypted backend endpoints, e.g. <API_URL>/api/<version>/query.
VITE_API_VERSION=v1
#
# Value of the X-Encrypted request/response header marker used by the
# per-session encryption protocol. Must match the backend.
VITE_ENCRYPTED_MARKER=1
#
# The per-session encryption key is issued by the backend (POST /api/v1/session)
# and is never baked into this bundle, so no secrets belong here.