DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=taskmanager
DB_SSLMODE=disable

SERVER_PORT=8080

# Public URL users are pointed to from SMS messages (e.g. the web app).
APP_URL=

# Browser origins allowed to call the API (comma-separated, exact match).
# REQUIRED in production, e.g. CORS_ORIGINS=https://app.example.com
# When empty, only loopback origins (localhost / 127.0.0.1 / ::1) are accepted —
# convenient for local development, safe by default everywhere else.
CORS_ORIGINS=

# Redis connection for the GraphQL response cache. If this is empty or Redis is
# unreachable the backend logs "cache: redis disabled" and serves every request
# straight from Postgres (caching is a pure optimisation, never a requirement).
REDIS_URL=redis://:password@localhost:6379/0

# JWT signing secrets. Generate strong random values, e.g.
# `openssl rand -base64 48`. Access tokens live 15 minutes; refresh tokens 30
# days and are rotated on every refresh. Rotating the secrets invalidates all
# live sessions.
JWT_SECRET=
JWT_REFRESH_SECRET=

SMS_KEY=
SMS_API_KEY=
SENDER_ID=
DEFAULT_SMS_SENDER_ID=
SMS_BASE_URL=https://api.mnotify.com/api/sms/quick

# Optional TLS (production): point at your certificates. The server also runs
# plain HTTP when these are absent (e.g. behind a TLS-terminating proxy).
TLS_CERT=
TLS_KEY=