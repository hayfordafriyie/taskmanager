DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=taskmanager
DB_SSLMODE=disable

SERVER_PORT=8080

# Redis connection for the response cache. Leave empty to fall back to the
# in-process memory cache (fine for local dev).
REDIS_URL=redis://:password@localhost:6379/0

# JWT signing secrets. Generate strong random values, e.g.
# `openssl rand -base64 48`. Access tokens live 15 minutes; refresh tokens 30
# days and are rotated on every refresh. Rotating the secrets invalidates all
# live sessions.
JWT_SECRET=
JWT_REFRESH_SECRET=

SMS_KEY=
SMS_API_KEY=
SENDER_ID=
DEFAULT_SMS_SENDER_ID=
SMS_BASE_URL=https://api.mnotify.com/api/sms/quick

# Optional TLS (production): point at your certificates. The server also runs
# plain HTTP when these are absent (e.g. behind a TLS-terminating proxy).
TLS_CERT=
TLS_KEY=