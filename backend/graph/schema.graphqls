scalar UUID
scalar Time

type User {
  id: UUID!
  phone: String!
  firstName: String!
  surname: String!
  otherNames: String
  createdAt: Time!
}

type OTPResult {
  success: Boolean!
  message: String!
  expiresInSeconds: Int
  retryAfterSeconds: Int
}

type VerifyOTPResult {
  success: Boolean!
  message: String!
}

type CreateAccountResult {
  success: Boolean!
  message: String!
  user: User
}

type LoginResult {
  success: Boolean!
  message: String!
  user: User
  accessToken: String
  refreshToken: String
}

type RefreshResult {
  success: Boolean!
  message: String!
  user: User
  accessToken: String
  refreshToken: String
}

type ResetPasswordResult {
  success: Boolean!
  message: String!
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

type Team {
  id: UUID!
  name: String!
  role: Role!
  members: [TeamMember!]!
  invites: [Invite!]!
}

type TeamMember {
  id: UUID!
  phone: String!
  firstName: String!
  surname: String!
  role: Role!
  createdAt: Time!
}

type Invite {
  id: UUID!
  teamName: String!
  phone: String!
  role: Role!
  status: String!
  invitedBy: User!
  expiresAt: Time!
  createdAt: Time!
}

type InviteResult {
  success: Boolean!
  message: String!
  invite: Invite
  inviteeRegistered: Boolean!
  alreadyMember: Boolean!
}

type AcceptInviteResult {
  success: Boolean!
  message: String!
  team: Team
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

type Task {
  id: UUID!
  teamId: UUID!
  title: String!
  description: String!
  status: TaskStatus!
  priority: Priority!
  dueAt: Time
  completedAt: Time
  createdAt: Time!
  updatedAt: Time!
  createdBy: User!
  assignee: User
}

type TaskResult {
  success: Boolean!
  message: String!
  task: Task
}

input CreateTaskInput {
  title: String!
  description: String = ""
  priority: Priority = MEDIUM
  dueAt: Time
  assigneeId: UUID
}

type Notification {
  id: UUID!
  kind: String!
  title: String!
  body: String!
  taskId: UUID
  read: Boolean!
  createdAt: Time!
}

input CreateAccountInput {
  phone: String!
  firstName: String!
  surname: String!
  otherNames: String
  password: String!
  confirmPassword: String!
}

type Query {
  health: String!
  me: User!
  myTeam: Team!
  myInvites: [Invite!]!
  teamTasks: [Task!]!
  notifications: [Notification!]!
  unreadNotificationCount: Int!
}

type Mutation {
  requestOTP(phone: String!): OTPResult!
  verifyOTP(phone: String!, code: String!): VerifyOTPResult!
  createAccount(input: CreateAccountInput!): CreateAccountResult!
  login(phone: String!, password: String!): LoginResult!
  refreshToken(token: String!): RefreshResult!
  logout: Boolean!
  requestPasswordReset(phone: String!): OTPResult!
  resetPassword(phone: String!, code: String!, password: String!, confirmPassword: String!): ResetPasswordResult!
  inviteToTeam(phone: String!, role: Role!): InviteResult!
  acceptInvite(inviteId: UUID!): AcceptInviteResult!
  revokeInvite(inviteId: UUID!): Boolean!
  createTask(input: CreateTaskInput!): TaskResult!
  assignTask(taskId: UUID!, assigneeId: UUID): TaskResult!
  setTaskStatus(taskId: UUID!, status: TaskStatus!): TaskResult!
  updateTaskDescription(taskId: UUID!, description: String!): TaskResult!
  markNotificationRead(id: UUID!): Boolean!
  markNotificationUnread(id: UUID!): Boolean!
  markAllNotificationsRead: Boolean!
  markAllNotificationsUnread: Boolean!
  deleteNotification(id: UUID!): Boolean!
  deleteAllNotifications: Boolean!
}