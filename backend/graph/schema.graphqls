scalar UUID
scalar Time

type User {
  id: UUID!
  phone: String!
  firstName: String!
  surname: String!
  otherNames: String
  createdAt: Time!
}

type OTPResult {
  success: Boolean!
  message: String!
  expiresInSeconds: Int
  retryAfterSeconds: Int
}

type VerifyOTPResult {
  success: Boolean!
  message: String!
}

type CreateAccountResult {
  success: Boolean!
  message: String!
  user: User
}

type LoginResult {
  success: Boolean!
  message: String!
  user: User
  accessToken: String
  refreshToken: String
}

type RefreshResult {
  success: Boolean!
  message: String!
  user: User
  accessToken: String
  refreshToken: String
}

type ResetPasswordResult {
  success: Boolean!
  message: String!
}

input CreateAccountInput {
  phone: String!
  firstName: String!
  surname: String!
  otherNames: String
  password: String!
  confirmPassword: String!
}

type Query {
  health: String!
  me: User!
}

type Mutation {
  requestOTP(phone: String!): OTPResult!
  verifyOTP(phone: String!, code: String!): VerifyOTPResult!
  createAccount(input: CreateAccountInput!): CreateAccountResult!
  login(phone: String!, password: String!): LoginResult!
  refreshToken(token: String!): RefreshResult!
  logout: Boolean!
  requestPasswordReset(phone: String!): OTPResult!
  resetPassword(phone: String!, code: String!, password: String!, confirmPassword: String!): ResetPasswordResult!
}