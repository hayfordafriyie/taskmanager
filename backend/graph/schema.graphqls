scalar UUID
scalar Time

type User {
  id: UUID!
  phone: String!
  firstName: String!
  surname: String!
  otherNames: String
  createdAt: Time!
}

type OTPResult {
  success: Boolean!
  message: String!
  expiresInSeconds: Int
  retryAfterSeconds: Int
}

type VerifyOTPResult {
  success: Boolean!
  message: String!
}

type CreateAccountResult {
  success: Boolean!
  message: String!
  user: User
}

type LoginResult {
  success: Boolean!
  message: String!
  user: User
  accessToken: String
  refreshToken: String
}

type RefreshResult {
  success: Boolean!
  message: String!
  user: User
  accessToken: String
  refreshToken: String
}

type ResetPasswordResult {
  success: Boolean!
  message: String!
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

type Team {
  id: UUID!
  name: String!
  role: Role!
  members: [TeamMember!]!
  invites: [Invite!]!
}

type TeamMember {
  id: UUID!
  phone: String!
  firstName: String!
  surname: String!
  role: Role!
  createdAt: Time!
}

type TeamSummary {
  id: UUID!
  name: String!
  role: Role!
  isOwner: Boolean!
  isActive: Boolean!
  memberCount: Int!
  ownerName: String
}

type SwitchTeamResult {
  success: Boolean!
  message: String!
  team: Team
}

type Invite {
  id: UUID!
  teamName: String!
  phone: String!
  role: Role!
  status: String!
  invitedBy: User!
  expiresAt: Time!
  createdAt: Time!
}

type InviteResult {
  success: Boolean!
  message: String!
  invite: Invite
  inviteeRegistered: Boolean!
  alreadyMember: Boolean!
}

type AcceptInviteResult {
  success: Boolean!
  message: String!
  team: Team
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

type Task {
  id: UUID!
  teamId: UUID!
  title: String!
  description: String!
  status: TaskStatus!
  priority: Priority!
  dueAt: Time
  startDate: Time
  endDate: Time
  completedAt: Time
  createdAt: Time!
  updatedAt: Time!
  createdBy: User!
  assignee: User
}

type TaskResult {
  success: Boolean!
  message: String!
  task: Task
}

input CreateTaskInput {
  title: String!
  description: String = ""
  priority: Priority = MEDIUM
  dueAt: Time
  startDate: Time
  endDate: Time
  assigneeId: UUID
}

input UpdateTaskInput {
  title: String
  description: String
  priority: Priority
  status: TaskStatus
  assigneeId: UUID
  startDate: Time
  endDate: Time
  "Removes the start date instead of leaving it untouched."
  clearStartDate: Boolean = false
  "Removes the end date instead of leaving it untouched."
  clearEndDate: Boolean = false
}

type Notification {
  id: UUID!
  kind: String!
  title: String!
  body: String!
  taskId: UUID
  read: Boolean!
  createdAt: Time!
}

type DashboardStats {
  doneToday: Int!
  inProgress: Int!
  overdue: Int!
  completedThisWeek: Int!
}

type DashboardSlice {
  key: String!
  label: String!
  count: Int!
  percent: Int!
}

type DashboardActivity {
  id: UUID!
  kind: String!
  title: String!
  body: String!
  createdAt: Time!
}

type DashboardDay {
  day: String!
  label: String!
  count: Int!
}

type Dashboard {
  stats: DashboardStats!
  completedToday: Int!
  upcomingTasks: [Task!]!
  statusBreakdown: [DashboardSlice!]!
  activity: [DashboardActivity!]!
  dueThisWeek: [DashboardDay!]!
}

type Message {
  id: UUID!
  conversationId: UUID!
  sender: User!
  body: String!
  createdAt: Time!
}

type Conversation {
  id: UUID!
  teamId: UUID!
  kind: String!
  peer: User
  lastMessage: Message
  lastMessageAt: Time!
  unreadCount: Int!
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  DONE
}

type KeyResult {
  id: UUID!
  title: String!
  progress: Int!
  createdAt: Time!
}

type Goal {
  id: UUID!
  teamId: UUID!
  title: String!
  description: String!
  status: GoalStatus!
  dueAt: Time
  createdAt: Time!
  updatedAt: Time!
  owner: User!
  progress: Int!
  keyResults: [KeyResult!]!
}

type GoalResult {
  success: Boolean!
  message: String!
  goal: Goal
}

input CreateGoalInput {
  title: String!
  description: String = ""
  status: GoalStatus = ON_TRACK
  dueAt: Time
  ownerId: UUID
}

type TimeEntry {
  id: UUID!
  userId: UUID!
  taskId: UUID
  taskTitle: String
  label: String!
  minutes: Int!
  spentOn: Time!
  note: String!
  createdAt: Time!
}

type TimeSummary {
  totalMinutes: Int!
  entryCount: Int!
  activeDays: Int!
  topLabel: String
  topMinutes: Int!
}

type TimeResult {
  success: Boolean!
  message: String!
  entry: TimeEntry
}

input LogTimeInput {
  taskId: UUID
  label: String
  minutes: Int!
  spentOn: Time
  note: String
}

type ReportPoint {
  label: String!
  value: Int!
}

type ReportSlice {
  key: String!
  label: String!
  count: Int!
  percent: Int!
}

type ReportWorkload {
  userId: UUID!
  name: String!
  initials: String!
  open: Int!
  done: Int!
  total: Int!
  percent: Int!
}

type Reports {
  completedPerDay: [ReportPoint!]!
  byStatus: [ReportSlice!]!
  workload: [ReportWorkload!]!
  totalTasks: Int!
  completedTasks: Int!
  overdueTasks: Int!
  completionRate: Int!
}

enum DocVisibility {
  TEAM
  PRIVATE
  RESTRICTED
}

type Doc {
  id: UUID!
  teamId: UUID!
  title: String!
  body: String!
  visibility: DocVisibility!
  createdAt: Time!
  updatedAt: Time!
  createdBy: User!
  canEdit: Boolean!
  accessCount: Int!
}

type DocAccess {
  userId: UUID!
  name: String!
  phone: String!
  canEdit: Boolean!
  grantedAt: Time!
}

type DocResult {
  success: Boolean!
  message: String!
  doc: Doc
}

input CreateAccountInput {
  phone: String!
  firstName: String!
  surname: String!
  otherNames: String
  password: String!
  confirmPassword: String!
}

type Query {
  health: String!
  me: User!
  myTeam: Team!
  myInvites: [Invite!]!
  myTeams: [TeamSummary!]!
  teamTasks: [Task!]!
  notifications: [Notification!]!
  unreadNotificationCount: Int!
  dashboard: Dashboard!
  conversations: [Conversation!]!
  conversationMessages(conversationId: UUID!, after: Time, limit: Int): [Message!]!
  teamGoals: [Goal!]!
  timeEntries(from: Time!, to: Time!): [TimeEntry!]!
  timeSummary(from: Time!, to: Time!): TimeSummary!
  reports: Reports!
  teamDocs: [Doc!]!
  docAccessList(docId: UUID!): [DocAccess!]!
}

type Mutation {
  requestOTP(phone: String!): OTPResult!
  verifyOTP(phone: String!, code: String!): VerifyOTPResult!
  createAccount(input: CreateAccountInput!): CreateAccountResult!
  login(phone: String!, password: String!): LoginResult!
  refreshToken(token: String!): RefreshResult!
  logout: Boolean!
  requestPasswordReset(phone: String!): OTPResult!
  resetPassword(phone: String!, code: String!, password: String!, confirmPassword: String!): ResetPasswordResult!
  inviteToTeam(phone: String!, role: Role!): InviteResult!
  acceptInvite(inviteId: UUID!): AcceptInviteResult!
  revokeInvite(inviteId: UUID!): Boolean!
  switchTeam(teamId: UUID!): SwitchTeamResult!
  createTask(input: CreateTaskInput!): TaskResult!
  updateTask(taskId: UUID!, input: UpdateTaskInput!): TaskResult!
  assignTask(taskId: UUID!, assigneeId: UUID): TaskResult!
  setTaskStatus(taskId: UUID!, status: TaskStatus!): TaskResult!
  updateTaskDescription(taskId: UUID!, description: String!): TaskResult!
  markNotificationRead(id: UUID!): Boolean!
  markNotificationUnread(id: UUID!): Boolean!
  markAllNotificationsRead: Boolean!
  markAllNotificationsUnread: Boolean!
  deleteNotification(id: UUID!): Boolean!
  deleteAllNotifications: Boolean!
  startConversation(memberId: UUID!): Conversation!
  sendMessage(conversationId: UUID!, body: String!): Message!
  markConversationRead(conversationId: UUID!): Boolean!
  createGoal(input: CreateGoalInput!): GoalResult!
  updateGoalStatus(goalId: UUID!, status: GoalStatus!): GoalResult!
  createKeyResult(goalId: UUID!, title: String!): GoalResult!
  setKeyResultProgress(keyResultId: UUID!, progress: Int!): GoalResult!
  deleteGoal(goalId: UUID!): Boolean!
  logTime(input: LogTimeInput!): TimeResult!
  deleteTimeEntry(entryId: UUID!): Boolean!
  createDoc(title: String!, body: String = "", visibility: DocVisibility = TEAM): DocResult!
  updateDoc(docId: UUID!, title: String, body: String, visibility: DocVisibility): DocResult!
  deleteDoc(docId: UUID!): Boolean!
  setDocAccess(docId: UUID!, userId: UUID!, canEdit: Boolean = false): DocResult!
  revokeDocAccess(docId: UUID!, userId: UUID!): Boolean!
}